  "values": {
    "twilightforest:canopy_log": {
      "transform_data": {
        "block_state_provider": {
          "type": "minecraft:rule_based",
          "rules": [
            {
              "if_true": {
                "type": "minecraft:matching_blocks",
                "blocks": "twilightforest:canopy_log"
              },
              "then": {
                "type": "minecraft:copy_properties",
                "source": {
                  "id": "twilightforest:stripped_canopy_log",
                  "properties": {
                    "axis": "y"
                  }
                }
              }
            }
          ]
        },
        "item_damage_per_use": 1,
        "sound": "minecraft:item.axe.strip"
      },
      "transformer": "minecraft:axe"
    },
